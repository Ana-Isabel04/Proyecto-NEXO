@model ReservasEventoViewModel
@{ Layout = "_LayoutOrganizador"; ViewData["Title"] = "Reservas del evento"; var e = Model.Evento; }
<div class="max-w-[1440px] mx-auto flex flex-col gap-space-lg">
    <a href="/Organizador" class="self-start flex items-center gap-1 font-label-md text-label-md uppercase"><span class="material-symbols-outlined text-[18px]">arrow_back</span>Volver al panel</a>
    <header class="rounded-3xl overflow-hidden bg-surface-container-lowest border border-surface-variant shadow-xl">
        <div class="relative">
            <partial name="_Portada" model='((string?)e.Categoria, e.ImageUrl, "h-52")' />
            <div class="absolute left-4 top-4 flex flex-wrap gap-space-xs">
                <span class="px-3 py-1 rounded-full bg-surface/90 font-label-sm text-label-sm uppercase tracking-widest font-bold">@e.Categoria</span>
                <partial name="_Estado" model="e.EstadoVisible" />
            </div>
        </div>
        <div class="p-space-lg flex flex-col lg:flex-row lg:items-end justify-between gap-space-md">
            <div class="min-w-0 break-words">
                <h1 class="font-headline-lg text-headline-lg text-primary tracking-tight">@e.Titulo</h1>
                <p class="flex flex-wrap gap-space-md font-body-sm text-body-sm text-on-surface-variant">
                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">calendar_today</span>@e.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">location_on</span>@e.Lugar</span>
                </p>
            </div>
            @if (e.Gestionable)
            {
                <a href="/Organizador/EditarEvento/@e.EventId" class="self-start shrink-0 flex items-center gap-space-xs px-space-lg py-3 rounded-xl bg-primary text-on-primary shadow-md font-label-lg text-label-lg"><span class="material-symbols-outlined text-[18px]">edit</span>Modificar ficha</a>
            }
        </div>
        <div class="px-space-lg pb-space-lg"><partial name="_BarraAforo" model="e" /></div>
    </header>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-space-md">
        <partial name="_Indicador" model='("Reservas confirmadas", e.Reservas, "confirmation_number")' />
        <partial name="_Indicador" model='("Cupos reservados", e.Reservados, "group")' />
        <partial name="_Indicador" model='("Cupos disponibles", e.Disponibles, "event_seat")' />
    </div>
    @if (!string.IsNullOrEmpty(Model.ExternalUrl))
    {
        <div class="flex items-start gap-space-sm rounded-2xl bg-secondary-fixed/50 p-space-md">
            <span class="material-symbols-outlined text-secondary">open_in_new</span>
            <p class="font-body-sm text-body-sm">Reserva o pago externo: <a href="@Model.ExternalUrl" target="_blank" rel="noopener noreferrer" class="underline break-all">@Model.ExternalUrl</a></p>
        </div>
    }
    <h2 class="font-headline-sm text-headline-sm text-primary">Listado de reservas</h2>
    <partial name="_TablaReservas" model="Model.Reservas" />
</div>
