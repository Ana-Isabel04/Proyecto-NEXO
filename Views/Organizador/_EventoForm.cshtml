@using System.Globalization
@model EventoFormViewModel
@{
    var d = Model.Datos;
    var inv = CultureInfo.InvariantCulture;
    const string input = "w-full h-12 px-4 rounded-lg border-0 bg-surface-container-low font-body-sm text-body-sm focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary transition-all";
    const string area = "w-full px-4 py-3 rounded-lg border-0 bg-surface-container-low font-body-sm text-body-sm focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary transition-all";
    const string label = "block font-label-md text-label-md uppercase tracking-wider text-on-surface-variant mb-1.5";
    const string card = "bg-surface-container-lowest border border-surface-variant rounded-2xl shadow-sm p-space-lg md:p-space-xl grid gap-space-md sm:grid-cols-2";
}
<div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-3 gap-space-lg">
    <form id="form-evento" data-id="@Model.EventId" class="lg:col-span-2 flex flex-col gap-space-lg" novalidate>
        <fieldset class="@card">
            <div class="sm:col-span-2 flex items-center gap-space-sm pb-space-sm border-b border-surface-variant">
                <span class="w-10 h-10 shrink-0 rounded-xl bg-surface-container flex items-center justify-center"><span class="material-symbols-outlined text-[20px]">edit_note</span></span>
                <div><p class="font-label-sm text-label-sm uppercase tracking-widest text-secondary">Paso 1 de 3</p><h2 class="font-headline-sm text-headline-sm">Información general</h2></div>
            </div>
            <div class="sm:col-span-2"><label asp-for="Datos.Title" class="@label"></label><input asp-for="Datos.Title" name="title" class="@input" /><span data-valmsg-for="title" data-valmsg-replace="true"></span></div>
            <div class="sm:col-span-2"><label asp-for="Datos.Description" class="@label"></label><textarea asp-for="Datos.Description" name="description" rows="4" class="@area"></textarea><span data-valmsg-for="description" data-valmsg-replace="true"></span></div>
            <div class="sm:col-span-2"><label asp-for="Datos.CategoryId" class="@label"></label>
                <div id="pills-categoria" class="flex flex-wrap gap-space-xs mb-space-xs">
                    @foreach (var c in Model.Categorias)
                    {
                        var icono = c.Name switch { "Música" => "music_note", "Tecnología" => "memory", "Deportivo" => "sports_soccer", "Gastronomía" => "restaurant", "Educativo" => "school", "Arte" => "palette", "Entretenimiento" => "theater_comedy", _ => "event" };
                        <button type="button" data-categoria="@c.CategoryId" data-icono="@icono" aria-pressed="@(d.CategoryId == c.CategoryId ? "true" : "false")" class="inline-flex items-center gap-1.5 px-space-md py-2.5 rounded-full bg-surface-container font-label-md text-label-md transition-all hover:-translate-y-0.5 aria-pressed:bg-primary aria-pressed:text-on-primary aria-pressed:shadow-md"><span class="material-symbols-outlined text-[16px]">@icono</span>@c.Name</button>
                    }
                </div>
                <select asp-for="Datos.CategoryId" name="categoryId" tabindex="-1" aria-hidden="true" class="sr-only" asp-items='new SelectList(Model.Categorias, "CategoryId", "Name")'><option value="">Selecciona…</option></select>
                <span data-valmsg-for="categoryId" data-valmsg-replace="true"></span></div>
            <div><label asp-for="Datos.StartsAt" class="@label"></label><input asp-for="Datos.StartsAt" name="startsAt" type="datetime-local" value="@d.StartsAt?.ToString("yyyy-MM-ddTHH:mm", inv)" class="@input" /><span data-valmsg-for="startsAt" data-valmsg-replace="true"></span></div>
            <div class="sm:col-span-2"><label asp-for="Datos.ImageUrl" class="@label"></label><input asp-for="Datos.ImageUrl" name="imageUrl" type="url" class="@input" /><span data-valmsg-for="imageUrl" data-valmsg-replace="true"></span></div>
        </fieldset>
        <fieldset class="@card">
            <div class="sm:col-span-2 flex items-center gap-space-sm pb-space-sm border-b border-surface-variant">
                <span class="w-10 h-10 shrink-0 rounded-xl bg-surface-container flex items-center justify-center"><span class="material-symbols-outlined text-[20px]">location_on</span></span>
                <div><p class="font-label-sm text-label-sm uppercase tracking-widest text-secondary">Paso 2 de 3</p><h2 class="font-headline-sm text-headline-sm">Ubicación</h2></div>
            </div>
            <div><label asp-for="Datos.VenueName" class="@label"></label><input asp-for="Datos.VenueName" name="venueName" class="@input" /><span data-valmsg-for="venueName" data-valmsg-replace="true"></span></div>
            <div><label asp-for="Datos.City" class="@label"></label><input asp-for="Datos.City" name="city" class="@input" /><span data-valmsg-for="city" data-valmsg-replace="true"></span></div>
            <div class="sm:col-span-2"><label asp-for="Datos.Address" class="@label"></label><input asp-for="Datos.Address" name="address" class="@input" /></div>
            <div class="sm:col-span-2">
                <p class="font-body-sm text-body-sm text-on-surface-variant mb-1">Haz clic en el mapa o arrastra el marcador.</p>
                <div id="mapa" class="h-80 rounded-xl overflow-hidden border border-surface-variant bg-surface-container relative z-0"></div>
                <p id="mapa-aviso" role="status" class="font-body-sm text-body-sm text-error"></p>
            </div>
            <div><label class="@label" for="latitude">Latitud</label><input id="latitude" name="latitude" type="number" step="any" min="-90" max="90" value="@d.Latitude?.ToString(inv)" class="@input" data-val="true" data-val-required="Marca la ubicación en el mapa." /><span data-valmsg-for="latitude" data-valmsg-replace="true"></span></div>
            <div><label class="@label" for="longitude">Longitud</label><input id="longitude" name="longitude" type="number" step="any" min="-180" max="180" value="@d.Longitude?.ToString(inv)" class="@input" data-val="true" data-val-required="Marca la ubicación en el mapa." /><span data-valmsg-for="longitude" data-valmsg-replace="true"></span></div>
        </fieldset>
        <fieldset class="@card">
            <div class="sm:col-span-2 flex items-center gap-space-sm pb-space-sm border-b border-surface-variant">
                <span class="w-10 h-10 shrink-0 rounded-xl bg-surface-container flex items-center justify-center"><span class="material-symbols-outlined text-[20px]">confirmation_number</span></span>
                <div><p class="font-label-sm text-label-sm uppercase tracking-widest text-secondary">Paso 3 de 3</p><h2 class="font-headline-sm text-headline-sm">Cupos, precio y contacto</h2></div>
            </div>
            <div><label asp-for="Datos.Price" class="@label"></label><input asp-for="Datos.Price" name="price" type="number" step="0.01" min="0" value="@d.Price?.ToString(inv)" class="@input" /><span data-valmsg-for="price" data-valmsg-replace="true"></span></div>
            <div><label asp-for="Datos.Capacity" class="@label"></label><input asp-for="Datos.Capacity" name="capacity" type="number" min="@Math.Max(1, Model.Reservados)" class="@input" data-reservados="@Model.Reservados" /><span data-valmsg-for="capacity" data-valmsg-replace="true"></span>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Reservados: @Model.Reservados · Disponibles: <span id="disponibles">—</span></p></div>
            <div class="sm:col-span-2"><label asp-for="Datos.ExternalUrl" class="@label"></label><input asp-for="Datos.ExternalUrl" name="externalUrl" type="url" class="@input" /><span data-valmsg-for="externalUrl" data-valmsg-replace="true"></span></div>
            <div class="sm:col-span-2"><label asp-for="Datos.Contact" class="@label"></label><input asp-for="Datos.Contact" name="contact" placeholder="Correo o teléfono" class="@input" /><span data-valmsg-for="contact" data-valmsg-replace="true"></span></div>
        </fieldset>
        <p id="mensaje" role="alert" class="font-body-md text-body-md text-error"></p>
        <div class="flex flex-wrap gap-space-sm bg-surface-container-low rounded-2xl p-space-md">
            @if (Model.Estado == EstadoEvento.Pendiente)
            {
                <button type="submit" class="px-space-lg py-3 rounded-xl bg-primary text-on-primary hover:bg-primary-container shadow-md font-label-lg text-label-lg uppercase tracking-wider">Guardar cambios (sigue en revisión)</button>
            }
            else
            {
                <button type="submit" data-publicar="true" class="px-space-lg py-3 rounded-xl bg-primary text-on-primary hover:bg-primary-container shadow-md font-label-lg text-label-lg uppercase tracking-wider">@(Model.Estado == EstadoEvento.Publicado ? "Guardar y mantener publicado" : "Publicar evento")</button>
                @if (Model.Reservados == 0)
                {
                    <button type="submit" class="px-space-lg py-3 rounded-xl bg-surface-container-lowest hover:bg-surface-container-high shadow-sm font-label-lg text-label-lg uppercase tracking-wider">Guardar como borrador</button>
                }
            }
        </div>
    </form>
    <aside class="lg:sticky lg:top-28 self-start flex flex-col gap-space-sm w-full">
        <p class="flex items-center gap-space-xs font-label-md text-label-md uppercase tracking-wider"><span class="w-2 h-2 rounded-full bg-secondary"></span>Vista previa en vivo · tarjeta pública</p>
        <article class="bg-surface-container-lowest border border-surface-variant rounded-3xl overflow-hidden shadow-xl">
            <div class="relative h-52 bg-gradient-to-br from-secondary-fixed via-surface-container to-tertiary-fixed flex items-center justify-center">
                <span id="pv-icono" class="material-symbols-outlined text-[56px] opacity-60">event</span>
                <img id="pv-imagen" alt="" class="hidden absolute inset-0 w-full h-full object-cover" />
                <span id="pv-categoria" class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-surface/90 backdrop-blur-md font-label-sm text-label-sm uppercase tracking-wider font-bold"></span>
                <span id="pv-precio" class="absolute top-3 right-3 px-3 py-1 rounded-full bg-primary text-on-primary font-label-lg text-label-lg shadow-md empty:hidden"></span>
            </div>
            <div class="p-space-lg flex flex-col gap-space-sm break-words">
                <p class="flex items-center gap-1.5 font-label-md text-label-md uppercase tracking-wider text-secondary"><span class="material-symbols-outlined text-[16px]">calendar_today</span><span id="pv-fecha"></span></p>
                <h3 id="pv-titulo" class="font-headline-md text-headline-md text-primary"></h3>
                <p class="flex items-center gap-1.5 font-body-sm text-body-sm text-on-surface-variant"><span class="material-symbols-outlined text-[16px]">location_on</span><span id="pv-lugar"></span></p>
                <p id="pv-descripcion" class="font-body-sm text-body-sm line-clamp-4"></p>
                <p id="pv-contacto" class="font-body-sm text-body-sm text-on-surface-variant empty:hidden"></p>
            </div>
        </article>
        <p class="flex items-start gap-space-xs rounded-xl bg-surface-container p-space-md font-body-sm text-body-sm text-on-surface-variant"><span class="material-symbols-outlined text-[18px] text-secondary">lightbulb</span>Una imagen horizontal y una descripción breve hacen la ficha más clara.</p>
    </aside>
</div>
