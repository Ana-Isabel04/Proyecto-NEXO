@model EventoFormViewModel
@{ Layout = "_LayoutOrganizador"; ViewData["Title"] = "Crear evento"; }
<div class="max-w-[1440px] mx-auto"><partial name="_Cabecera" model='("Nueva convocatoria", "Crear evento", "Completa los tres bloques y revisa la tarjeta antes de publicar.", "add_circle")' /></div>
<partial name="_EventoForm" model="Model" />
@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
}
@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/js/evento-form.js" asp-append-version="true"></script>
}
