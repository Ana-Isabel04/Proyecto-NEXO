@model EventoResumenViewModel?
@{ ViewData["Title"] = "Valorar evento"; }
<div class="max-w-[860px] mx-auto flex flex-col gap-space-lg">
    <div class="flex items-center gap-space-sm font-label-md text-label-md uppercase text-on-surface-variant">
        <a href="/Perfil" class="flex items-center gap-1 hover:text-primary transition-colors"><span class="material-symbols-outlined text-[18px]">arrow_back</span>Volver a mi perfil</a>
        <span class="text-outline">/</span><span class="text-on-surface">Valorar evento</span>
    </div>
    @if (Model is null)
    {
        <partial name="_EstadoVacioPartial" model='new EstadoVacioViewModel("No puedes valorar este evento", "Necesitas una reserva confirmada de un evento ya realizado y no haberlo valorado antes.", "block", "Volver a mi perfil", "/Perfil")' />
    }
    else
    {
        <div class="relative overflow-hidden rounded-xl bg-surface-container-high p-space-md md:p-space-lg shadow-sm flex items-center gap-space-sm">
            <div class="absolute -right-8 -top-8 w-40 h-40 rounded-full bg-secondary-fixed/30 blur-2xl pointer-events-none"></div>
            <span class="w-10 h-10 shrink-0 rounded-full bg-surface-container-lowest flex items-center justify-center shadow-sm"><span class="material-symbols-outlined text-[20px]">verified_user</span></span>
            <div>
                <p class="font-label-md text-label-md uppercase tracking-wider">Reserva confirmada</p>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Evento realizado el @Model.Fecha.ToString("dd/MM/yyyy") a las @Model.Fecha.ToString("HH:mm")</p>
            </div>
        </div>
        <section class="rounded-3xl overflow-hidden bg-surface-container-lowest border border-surface-variant shadow-lg">
            <div class="relative">
                <partial name="_Portada" model='((string?)Model.Categoria, Model.ImagenUrl, "h-64")' />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
                <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-surface/90 font-label-sm text-label-sm uppercase tracking-widest font-bold">@Model.Categoria</span>
                <h1 class="absolute bottom-4 left-5 right-5 font-headline-lg text-headline-lg text-white break-words">@Model.Titulo</h1>
            </div>
            <div class="p-space-md flex flex-wrap gap-space-xs">
                @foreach (var (icono, texto) in new[] { ("calendar_today", Model.Fecha.ToString("dd/MM/yyyy")), ("schedule", Model.Fecha.ToString("HH:mm") + " h"), ("location_on", Model.Lugar), ("confirmation_number", Model.CodigoReserva) })
                {
                    <span class="inline-flex items-center gap-1.5 px-space-md py-2 rounded-full bg-surface-container font-label-md text-label-md"><span class="material-symbols-outlined text-[16px] text-secondary">@icono</span>@texto</span>
                }
            </div>
        </section>
        <form id="form-valoracion" data-event="@Model.EventId" class="rounded-xl bg-surface-container-lowest border border-surface-variant p-space-lg md:p-space-xl shadow-sm flex flex-col gap-space-xl" novalidate>
            <fieldset>
                
                <legend class="mb-space-sm"><span class="block font-label-md text-label-md uppercase tracking-wider">1. Valoración global</span><span class="block font-headline-sm text-headline-sm">¿Cómo calificarías este evento?</span></legend>
                <div class="rounded-xl bg-surface-container-low p-space-lg flex flex-col items-center gap-space-sm">
                    <div class="flex gap-space-sm">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <button type="button" data-star="@i" aria-label="@i de 5" aria-pressed="false" class="material-symbols-outlined text-[56px] text-on-tertiary-container drop-shadow-sm hover:scale-125 transition-transform">star</button>
                        }
                    </div>
                    <p class="font-headline-sm text-headline-sm"><span id="nota">–</span> <span class="font-body-sm text-body-sm text-on-surface-variant">/ 5</span></p>
                    <p id="nota-texto" class="font-body-sm text-body-sm italic text-on-surface-variant">Selecciona las estrellas</p>
                </div>
            </fieldset>
            <div>
                <p class="font-label-md text-label-md uppercase tracking-wider">2. Aspectos clave</p>
                <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-sm">Al seleccionar un aspecto se añade a tu comentario.</p>
                <div class="flex flex-wrap gap-space-xs">
                    @foreach (var aspecto in new[] { "Excelente acústica", "Organización impecable", "Atmósfera íntima", "Puntualidad", "Buena curaduría", "Mediación explicativa" })
                    {
                        <button type="button" data-aspecto="@aspecto" aria-pressed="false" class="px-space-md py-2 rounded-full bg-surface-container font-label-md text-label-md transition-colors aria-pressed:bg-primary aria-pressed:text-on-primary aria-pressed:shadow-md hover:-translate-y-0.5 inline-flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px]" aria-hidden="true">auto_awesome</span>@aspecto</button>
                    }
                </div>
            </div>
            <div>
                <label for="comentario" class="block font-label-md text-label-md uppercase tracking-wider mb-space-sm">3. Tu testimonio (opcional)</label>
                <textarea id="comentario" maxlength="1000" rows="6" placeholder="Comparte lo que viviste" class="w-full p-space-md rounded-lg border-0 bg-surface-container-low font-body-md text-body-md focus:ring-1 focus:ring-primary"></textarea>
                <p class="text-right font-label-sm text-label-sm text-on-surface-variant"><span id="contador">0</span> / 1000 caracteres</p>
            </div>
            <p id="mensaje" role="alert" class="font-body-sm text-body-sm text-error"></p>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end items-center gap-space-md">
                <a href="/Perfil" class="font-label-md text-label-md uppercase tracking-wider">Cancelar</a>
                <button type="submit" class="h-12 w-full sm:w-auto px-space-xl rounded-xl bg-primary text-on-primary hover:bg-primary-container shadow-md font-label-lg text-label-lg uppercase tracking-wider flex items-center justify-center gap-2"><span class="material-symbols-outlined text-[18px]">publish</span>Enviar valoración</button>
            </div>
        </form>
    }
</div>
@section Scripts {
    <script src="~/js/valorar.js" asp-append-version="true"></script>
    <script>
        // Solo presentación: la nota visible, el contador y los chips que escriben en el comentario.
        (() => {
            const area = document.getElementById('comentario');
            if (!area) return;
            const textos = ['Deficiente', 'Mejorable', 'Correcta', 'Muy buena', 'Excelente'];
            const contar = () => document.getElementById('contador').textContent = area.value.length;
            const chips = [...document.querySelectorAll('[data-aspecto]')];
            document.querySelectorAll('[data-star]').forEach(b => b.addEventListener('click', () => {
                document.getElementById('nota').textContent = b.dataset.star;
                document.querySelectorAll('[data-star]').forEach(x => { x.classList.remove('nx-pop'); if (x.dataset.star <= b.dataset.star) { void x.offsetWidth; x.classList.add('nx-pop'); } });
                document.getElementById('nota-texto').textContent = textos[b.dataset.star - 1];
            }));
            const sincronizar = () => {
                chips.forEach(c => c.setAttribute('aria-pressed', String(area.value.includes(c.dataset.aspecto + '.'))));
                contar();
            };
            chips.forEach(c => c.addEventListener('click', () => {
                const frase = c.dataset.aspecto + '.';
                const nuevo = area.value.includes(frase)
                    ? area.value.replace(frase, '').replace(/ {2,}/g, ' ').trim()
                    : `${area.value.trim()} ${frase}`.trim();
                if (nuevo.length <= area.maxLength) area.value = nuevo;
                sincronizar();
            }));
            area.addEventListener('input', sincronizar);
        })();
    </script>
}
