@model DashboardAdminViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Consola central";
    var modulos = new (string Url, string Icono, string Titulo, string Texto, string Tono)[]
    {
        ("/Admin/Eventos", "event_note", "Gestión de eventos", $"{Model.Eventos} eventos registrados.", "bg-secondary-fixed text-on-secondary-fixed"),
        ("/Admin/Usuarios", "badge", "Directorio de cuentas", $"{Model.Usuarios} usuarios y {Model.Organizadores} organizadores.", "bg-tertiary-fixed text-on-tertiary-fixed"),
        ("/Admin/Reservas", "confirmation_number", "Monitor de reservas", $"{Model.Reservas} reservas confirmadas.", "bg-emerald-100 text-emerald-900"),
        ("/Admin/Reportes", "flag", "Reportes", $"{Model.ReportesPendientes} pendientes de revisión.", "bg-error-container text-on-error-container")
    };
}
<partial name="_Cabecera" model='("Consola central NEXO · Gobernanza", "Supervisión Cultural", "Estado actual de la cartelera, la comunidad y las incidencias.", "monitoring")' />
<div class="flex flex-col gap-space-xl">
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-space-md">
        <partial name="_Indicador" model='("Eventos en revisión", Model.EventosEnRevision, "assignment_late")' />
        <partial name="_Indicador" model='("Reportes pendientes", Model.ReportesPendientes, "flag")' />
        <partial name="_Indicador" model='("Comunidad", Model.Usuarios, "groups")' />
        <partial name="_Indicador" model='("Reservas confirmadas", Model.Reservas, "confirmation_number")' />
    </div>
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-space-lg items-start">
        <section class="xl:col-span-2 bg-surface-container-lowest border border-surface-variant rounded-3xl p-space-lg shadow-sm flex flex-col gap-space-md">
            <div class="flex flex-wrap items-center justify-between gap-space-sm">
                <h2 class="flex items-center gap-space-xs font-headline-sm text-headline-sm"><span class="w-2 h-2 rounded-full bg-secondary"></span>Moderación rápida</h2>
                <a href="/Admin/Eventos?estado=@EstadoEvento.Pendiente" class="px-space-md py-2 rounded-lg bg-primary text-on-primary font-label-md text-label-md uppercase">Ver cola de revisión</a>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Últimos eventos registrados.</p>
            @if (Model.Recientes.Count == 0)
            {
                <partial name="_EstadoVacioPartial" model='new EstadoVacioViewModel("Sin eventos", "Todavía no hay eventos registrados.", "event_busy")' />
            }
            @foreach (var e in Model.Recientes)
            {
                var url = $"/api/admin/eventos/{e.EventId}/moderar";
                <article class="rounded-2xl bg-surface-container-low p-space-sm flex flex-wrap items-center gap-space-md">
                    <partial name="_Portada" model='((string?)e.Categoria, e.ImageUrl, "w-20 h-20 rounded-xl shrink-0")' />
                    <div class="flex-1 min-w-[12rem] break-words">
                        <div class="flex flex-wrap items-center gap-space-xs"><partial name="_Estado" model="e.EstadoVisible" /><span class="font-label-sm text-label-sm uppercase text-on-surface-variant">@e.Categoria</span></div>
                        <p class="font-title-lg text-title-lg">@e.Titulo</p>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">@e.Organizador · @e.Lugar · @e.Fecha.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="flex gap-space-xs">
                        <a href="/Admin/Eventos/@e.EventId" title="Revisar" aria-label="Revisar" class="w-11 h-11 rounded-xl bg-surface-container-lowest flex items-center justify-center shadow-sm"><span class="material-symbols-outlined text-[20px]">visibility</span></a>
                        @if (e.Estado == EstadoEvento.Publicado)
                        {
                            <button type="button" title="Ocultar" aria-label="Ocultar" data-api="@url" data-method="POST" data-body='{"accion":"ocultar"}' data-confirm="¿Ocultar este evento?" class="w-11 h-11 rounded-xl bg-surface-container-lowest text-error flex items-center justify-center shadow-sm"><span class="material-symbols-outlined text-[20px]">visibility_off</span></button>
                        }
                        else if (e.Estado == EstadoEvento.Pendiente)
                        {
                            <button type="button" title="Aprobar" aria-label="Aprobar" data-api="@url" data-method="POST" data-body='{"accion":"aprobar"}' data-confirm="¿Aprobar y publicar este evento?" class="w-11 h-11 rounded-xl bg-primary text-on-primary flex items-center justify-center shadow-sm"><span class="material-symbols-outlined text-[20px]">check</span></button>
                        }
                    </div>
                </article>
            }
        </section>
        <aside class="flex flex-col gap-space-md">
            @if (Model.OrganizadoresSinVerificar > 0)
            {
                <a href="/Admin/Usuarios" class="rounded-2xl bg-secondary-fixed text-on-secondary-fixed p-space-lg flex items-center gap-space-md shadow-sm">
                    <span class="material-symbols-outlined text-[32px]">verified_user</span>
                    <span><span class="block font-title-lg text-title-lg">Organizadores sin verificar: @Model.OrganizadoresSinVerificar</span><span class="block font-body-sm text-body-sm">Revisar cuentas →</span></span>
                </a>
            }
            <h2 class="font-title-lg text-title-lg">Accesos directos</h2>
            @foreach (var m in modulos)
            {
                <a href="@m.Url" class="bg-surface-container-lowest border border-surface-variant rounded-2xl p-space-md shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all flex items-center gap-space-md">
                    <span class="w-12 h-12 shrink-0 rounded-xl flex items-center justify-center @m.Tono"><span class="material-symbols-outlined">@m.Icono</span></span>
                    <span class="flex-1"><span class="block font-title-md text-title-md">@m.Titulo</span><span class="block font-body-sm text-body-sm text-on-surface-variant">@m.Texto</span></span>
                    <span class="material-symbols-outlined text-on-surface-variant">arrow_forward</span>
                </a>
            }
        </aside>
    </div>
</div>
