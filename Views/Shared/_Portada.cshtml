@model (string? Categoria, string? ImagenUrl, string Clases)
@{
    // El fondo con icono queda de respaldo si no hay URL o la foto no carga.
    var (icono, tono) = Model.Categoria switch
    {
        "Música" => ("music_note", "from-rose-200 via-rose-100 to-amber-100 text-rose-900"),
        "Tecnología" => ("memory", "from-blue-200 via-indigo-100 to-violet-100 text-blue-900"),
        "Deportivo" => ("sports_soccer", "from-emerald-200 via-emerald-100 to-lime-100 text-emerald-900"),
        "Gastronomía" => ("restaurant", "from-orange-200 via-amber-100 to-yellow-100 text-orange-900"),
        "Educativo" => ("school", "from-indigo-200 via-violet-100 to-fuchsia-100 text-indigo-900"),
        "Arte" => ("palette", "from-red-200 via-orange-100 to-amber-100 text-red-900"),
        "Entretenimiento" => ("theater_comedy", "from-amber-200 via-yellow-100 to-orange-100 text-amber-900"),
        _ => ("event", "from-stone-200 via-stone-100 to-amber-50 text-stone-800")
    };
}
<div class="relative overflow-hidden bg-gradient-to-br @tono @Model.Clases flex items-center justify-center">
    <span class="absolute -right-6 -top-6 w-24 h-24 rounded-full bg-white/40 blur-xl"></span>
    <span class="absolute -left-8 -bottom-10 w-32 h-32 rounded-full border border-current opacity-20"></span>
    <span class="material-symbols-outlined text-[44px] opacity-70" aria-hidden="true">@icono</span>
    @if (!string.IsNullOrEmpty(Model.ImagenUrl))
    {
        <img src="@Model.ImagenUrl" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover" onerror="this.remove()" />
    }
</div>
