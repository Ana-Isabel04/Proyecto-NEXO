@model (string Nombre, string Clases)
@{ var iniciales = string.Concat(Model.Nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpper(); }
<span class="shrink-0 rounded-full bg-gradient-to-br from-secondary-fixed to-tertiary-fixed text-on-secondary-fixed flex items-center justify-center font-semibold shadow-sm @Model.Clases" aria-hidden="true">@iniciales</span>
