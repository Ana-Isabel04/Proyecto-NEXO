@{
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var nombreAdmin = User.Identity?.Name ?? "Administrador NEXO";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Consola NEXO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface": "#fdf9f2", "primary-container": "#1c1b1b", "surface-container-highest": "#e6e2db",
                        "on-secondary-fixed-variant": "#5a00c6", "on-secondary-fixed": "#25005a", "surface-tint": "#5f5e5e",
                        "on-primary": "#ffffff", "on-background": "#1c1c18", "error": "#ba1a1a", "background": "#fdf9f2",
                        "primary": "#000000", "error-container": "#ffdad6", "tertiary-fixed-dim": "#ffb95f",
                        "outline-variant": "#c4c7c7", "on-secondary": "#ffffff", "secondary": "#712ae2",
                        "on-surface-variant": "#444748", "on-error": "#ffffff", "surface-container-low": "#f7f3ec",
                        "surface-container": "#f1ede6", "secondary-fixed": "#eaddff", "surface-container-high": "#ece8e1",
                        "on-error-container": "#93000a", "secondary-container": "#8a4cfc", "outline": "#747878",
                        "surface-container-lowest": "#ffffff", "on-surface": "#1c1c18"
                    },
                    spacing: {
                        "space-sm": "0.5rem", "margin-desktop": "2.5rem", "gutter-desktop": "2rem",
                        "space-xs": "0.25rem", "space-xl": "2.5rem", "space-md": "1rem", "space-lg": "1.5rem"
                    },
                    fontFamily: {
                        "display": ["Newsreader", "serif"], "headline-lg": ["Newsreader", "serif"],
                        "headline-md": ["Newsreader", "serif"], "headline-sm": ["Newsreader", "serif"],
                        "title-lg": ["Plus Jakarta Sans", "sans-serif"], "title-md": ["Plus Jakarta Sans", "sans-serif"],
                        "body-lg": ["Plus Jakarta Sans", "sans-serif"], "body-md": ["Plus Jakarta Sans", "sans-serif"],
                        "body-sm": ["Plus Jakarta Sans", "sans-serif"], "label-lg": ["Plus Jakarta Sans", "sans-serif"],
                        "label-md": ["Plus Jakarta Sans", "sans-serif"], "label-sm": ["Plus Jakarta Sans", "sans-serif"]
                    },
                    fontSize: {
                        "label-sm": ["10px", { "lineHeight": "12px", "letterSpacing": "0.06em", "fontWeight": "600" }],
                        "title-md": ["16px", { "lineHeight": "22px", "fontWeight": "600" }],
                        "label-md": ["11px", { "lineHeight": "14px", "letterSpacing": "0.05em", "fontWeight": "600" }],
                        "display": ["56px", { "lineHeight": "64px", "letterSpacing": "-0.02em", "fontWeight": "400" }],
                        "headline-sm": ["22px", { "lineHeight": "28px", "fontWeight": "500" }],
                        "body-sm": ["13px", { "lineHeight": "18px", "fontWeight": "400" }],
                        "body-md": ["15px", { "lineHeight": "22px", "fontWeight": "400" }],
                        "title-lg": ["18px", { "lineHeight": "24px", "fontWeight": "600" }],
                        "label-lg": ["13px", { "lineHeight": "16px", "letterSpacing": "0.04em", "fontWeight": "700" }],
                        "headline-lg": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.015em", "fontWeight": "400" }],
                        "body-lg": ["17px", { "lineHeight": "26px", "fontWeight": "400" }],
                        "headline-md": ["28px", { "lineHeight": "34px", "letterSpacing": "-0.01em", "fontWeight": "500" }]
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-surface font-body-md text-on-surface antialiased">

    <!-- Topbar Superior de Consola -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
        <div class="h-20 w-full px-margin-desktop flex items-center justify-between gap-space-lg">
            <div class="flex items-center gap-space-lg flex-shrink-0">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-space-sm">
                    <span class="font-display text-headline-sm font-semibold tracking-tight text-primary">NEXO</span>
                    <span class="font-label-sm text-label-sm uppercase bg-surface-container-highest text-on-surface-variant px-2 py-0.5 rounded tracking-widest">Console</span>
                </a>
                <div class="h-4 w-px bg-surface-container-highest hidden sm:block"></div>
                <div class="hidden sm:flex items-center gap-space-xs">
                    <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                    <span class="font-label-sm text-label-sm tracking-widest uppercase text-on-surface font-semibold">Administración Central</span>
                </div>
            </div>

            <div class="flex items-center gap-space-md flex-shrink-0">
                <a asp-controller="Home" asp-action="Index" class="hidden md:flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface font-label-md text-label-md transition-colors">
                    <span class="material-symbols-outlined text-[16px]">public</span>
                    <span>Ver Portal Público</span>
                </a>
                <div class="h-6 w-px bg-surface-container-highest"></div>
                <div class="flex items-center gap-space-sm">
                    <div class="text-right hidden lg:block">
                        <p class="font-title-md text-body-sm text-primary leading-tight font-semibold">@nombreAdmin</p>
                        <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Rol Administrador</p>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-on-primary text-[18px]">admin_panel_settings</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Sidebar Lateral Fijo -->
    <aside class="fixed left-0 top-20 bottom-0 w-72 bg-surface-container-low z-40 hidden lg:flex flex-col justify-between py-space-lg shadow-[0_1px_8px_rgba(0,0,0,0.02)]">
        <div class="flex flex-col gap-space-lg px-space-md">
            <div class="px-space-sm">
                <p class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant">Módulos de Gobernanza</p>
            </div>
            <nav class="flex flex-col gap-1.5">
                <a asp-controller="Admin" asp-action="Panel"
                   class="flex items-center px-4 py-3 transition-all rounded-xl @(accionActual == "Panel" ? "bg-primary text-on-primary font-bold" : "text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface font-title-md text-body-md")">
                    <span class="material-symbols-outlined mr-3 text-[20px]">dashboard</span>
                    Consola Central
                </a>
                <a asp-controller="Admin" asp-action="GestionEventos"
                   class="flex items-center px-4 py-3 transition-all rounded-xl @(accionActual == "GestionEventos" || accionActual == "RevisionEvento" ? "bg-primary text-on-primary font-bold" : "text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface font-title-md text-body-md")">
                    <span class="material-symbols-outlined mr-3 text-[20px]">event_available</span>
                    Catálogo y Moderación
                </a>
                <a asp-controller="Admin" asp-action="GestionUsuarios"
                   class="flex items-center px-4 py-3 transition-all rounded-xl @(accionActual == "GestionUsuarios" ? "bg-primary text-on-primary font-bold" : "text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface font-title-md text-body-md")">
                    <span class="material-symbols-outlined mr-3 text-[20px]">group</span>
                    Directorio Usuarios
                </a>
                <a asp-controller="Admin" asp-action="GestionReservas"
                   class="flex items-center px-4 py-3 transition-all rounded-xl @(accionActual == "GestionReservas" ? "bg-primary text-on-primary font-bold" : "text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface font-title-md text-body-md")">
                    <span class="material-symbols-outlined mr-3 text-[20px]">confirmation_number</span>
                    Reservas Globales
                </a>
            </nav>
        </div>

        <div class="px-space-md pt-space-lg flex flex-col gap-space-sm">
            <div class="p-space-md rounded-xl bg-surface-container text-on-surface flex flex-col gap-1">
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm uppercase text-on-surface-variant">Estado Sistema</span>
                    <span class="font-label-sm text-label-sm font-semibold text-secondary">Operativo</span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Auditoría y control de roles activo</p>
            </div>
            <div class="px-space-sm flex items-center justify-between">
                <p class="font-label-sm text-label-sm text-on-surface-variant">© 2026 NEXO Cultural</p>
                <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                    <button type="submit" class="font-label-sm text-label-sm text-error hover:underline font-bold">Salir</button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Contenido Principal -->
    <div class="lg:pl-72">
        <main class="relative w-full pt-24 bg-surface px-margin-desktop py-space-xl min-h-screen">
            @if (TempData["MensajeExito"] != null)
            {
                <div class="mb-space-lg p-space-md rounded-xl bg-emerald-50 text-emerald-900 font-body-sm flex items-center justify-between shadow-sm">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-emerald-700 text-[20px]">check_circle</span>
                        <span>@TempData["MensajeExito"]</span>
                    </div>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>